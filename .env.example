# ===================================================
# CONFIGURACIÓN DEL SISTEMA DE CAPTURA & NOTION CRM
# ===================================================

# Token de integración de Notion (creado en https://www.notion.so/profile/integrations)
# Ejemplo: ntn_xxxxxxxxxxxxxxxxxxxxxxxxxx o secret_xxxxxxxxxxxxxxxxxxxx
NOTION_TOKEN=tu_notion_token_aqui

# ID de la base de datos de Notion donde se insertarán los leads
# (o el ID de la página padre si vas a ejecutar el creador automático de base de datos)
NOTION_DATABASE_ID=tu_database_id_aqui
